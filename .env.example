# Copy to .env.local for machine-specific overrides (never committed).
# All variables exposed to the browser must start with VITE_.

# development | production
VITE_APP_ENV=development

# true  = everything runs in the browser against generated mock data (this repo)
# false = call the real Dashboard Traceability Application Server (not built yet)
VITE_USE_MOCK=true

# Placeholders - replace with the hostnames from the PTCT network plan.
VITE_API_BASE_URL=https://ptct-dtas01:3000/api/v1
VITE_WS_URL=wss://ptct-dtas01:3000/ws
VITE_OPC_ENDPOINT=opc.tcp://ptct-opc01:4840
VITE_LDAP_DOMAIN=PTCT
